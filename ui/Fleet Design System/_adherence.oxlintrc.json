{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/fleet/**",
              "components/icons/**",
              "components/signals/**",
              "components/surfaces/**",
              "ui_kits/hud/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow Condensed|Barlow|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Barlow Condensed, Barlow, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaptureRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|segments|tone|mode|size|label|sub|style|key|ref|className|style|children)$/]",
        "message": "<CaptureRing> doesn't accept that prop. Declared props: value, segments, tone, mode, size, label, sub, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaptureRing'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:friendly|enemy|neutral)$/]",
        "message": "<CaptureRing> tone must be one of 'friendly' | 'enemy' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaptureRing'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:fill|contested|decay)$/]",
        "message": "<CaptureRing> mode must be one of 'fill' | 'contested' | 'decay'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommandButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CommandButton> doesn't accept that prop. Declared props: children, variant, size, icon, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommandButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:commit|danger|ghost)$/]",
        "message": "<CommandButton> variant must be one of 'commit' | 'danger' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommandButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<CommandButton> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|tone|children|style|key|ref|className|style|children)$/]",
        "message": "<ConfidenceTag> doesn't accept that prop. Declared props: level, tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceTag'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:confirmed|estimated|stale|unknown)$/]",
        "message": "<ConfidenceTag> level must be one of 'confirmed' | 'estimated' | 'stale' | 'unknown'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceTag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:friendly|enemy|neutral)$/]",
        "message": "<ConfidenceTag> tone must be one of 'friendly' | 'enemy' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DoctrinePill'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|glyph|active|mixed|onClick|style|key|ref|className|style|children)$/]",
        "message": "<DoctrinePill> doesn't accept that prop. Declared props: label, value, glyph, active, mixed, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FleetChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|strength|state|drones|capitals|tone|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<FleetChip> doesn't accept that prop. Declared props: id, strength, state, drones, capitals, tone, selected, onClick, style."

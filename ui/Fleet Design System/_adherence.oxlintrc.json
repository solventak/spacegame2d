      {
        "selector": "JSXOpeningElement[name.name='FleetChip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|moving|committed|engaged|planned)$/]",
        "message": "<FleetChip> state must be one of 'idle' | 'moving' | 'committed' | 'engaged' | 'planned'."

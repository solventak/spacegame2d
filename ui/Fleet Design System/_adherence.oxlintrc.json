      {
        "selector": "JSXOpeningElement[name.name='FleetChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:friendly|enemy)$/]",
        "message": "<FleetChip> tone must be one of 'friendly' | 'enemy'."
